	select MMU_GATHER_MERGE_VMAS 	if MMU
	select ARCH_SUPPORTS_HUGETLBFS	if MMU
	select ARCH_WANT_GENERAL_HUGETLB	if MMU
	select ARCH_SUPPORTS_MEMORY_FAILURE if MMU
	select NEED_PER_CPU_EMBED_FIRST_CHUNK
	select THREAD_INFO_IN_TASK
	select TRACING

config ARCH_HAS_PROC_MAPS
	def_bool y

menu "Flux configuration"

config FLUX_STATIC_HUGETLB_SHARE
	bool "Use shared hugetlb PMDs for static Flux memory"
	depends on !NUMA && !FLUX_MPK && !FLUX_FNET && !FLUX_SPDK
	default n
	help
	  Experimental native host hugetlb page-table sharing. Static memory
	  (DMA plus normal memory minus the elastic pool) must be a multiple
	  of 1 GiB. Requires a preallocated host 2 MiB hugepage pool. Allocation
	  failure aborts boot; there is no silent base-page fallback. Elastic
	  memory retains its separate reclaimable base-page backing.

config FLUX_HOST_FAULT_REPAIR
	bool "Resolve fork-child read faults in the host with fault-around"
	default n
	help
	  Bind the software page-table root and readable private-anonymous VMA
	  ranges while constructing a fork child. A compatible host module can
	  resolve read faults and project a bounded batch of neighboring pages
	  without SIGSEGV or per-page ioctl round trips. Invalidation retires
	  affected ranges before guest page/table reuse. Writes, executable or
	  shared mappings, and failed registration retain the normal fault path.
	  The module must enable fork_fault_repair separately.

config FLUX_FAULT_STATS
	bool "Collect Flux fault bridge diagnostics"
	depends on PROC_FS
	default n
	help
	  Expose cumulative fault-entry, alias-repair attempt and MM-resolution
	  counters in /proc/flux_fault_stats. Counting is disabled at boot and
	  can be enabled by an administrator with "enable 1". This diagnostic
	  option adds overhead when enabled; leave it off for timing runs.

config FLUX_FORK_STATS
	bool "Collect Flux fork phase elapsed-time diagnostics"
	depends on PROC_FS
	default n
	help
	  Expose cumulative count and nanoseconds per fork phase through
	  /proc/flux_fork_stats. Disabled at boot; an administrator can enable
	  observations with "enable 1". These are inclusive elapsed times,
	  not exclusive CPU costs. Build without this option for a baseline.

config FLUX_LINUX66_COMPAT
	bool "Enable the Linux 6.6 compatibility profile"
	default n
	help
	  Enable the architecture capabilities used by the dedicated
	  linux66_compat_defconfig. Leave this disabled for the original Flux
	  configuration so compatibility-only selections do not change its
	  established behavior.

config 64BIT
	bool "64-bit kernel"
	default y

config X86_64
	def_bool y
	depends on 64BIT

config X86_UMIP
	bool "Expose host x86 UMIP capability"
	depends on X86_64 && FLUX_LINUX66_COMPAT
	help
	  Flux user instructions execute on the x86 host. Enable this only when
	  the host kernel enforces User-Mode Instruction Prevention so userspace
	  and capability probes observe the effective execution environment.

config FLUX_UINTR
	def_bool y
	depends on X86_64

config FLUX_MPK
	bool "Isolate the Flux kernel from applications with MPK"
	default n
	depends on X86_64
	help
	  Put the Flux kernel and host runtime in a protection-key domain and
	  switch PKRU at the Flux syscall gates. The loader rejects application
	  code containing WRPKRU or XRSTOR and the host module enforces W^X. This
	  option is independent of the Linux 6.6 compatibility profile. Enable it
	  only with a host module and runtime built for MPK isolation.

config OUTPUT_FORMAT
       string "Output format"
       default ""

